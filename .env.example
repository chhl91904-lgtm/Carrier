# CANE MATE runs in a non-payment, non-location-tracking demo mode by default.
NEXT_PUBLIC_APP_MODE=demo

# Required for live authentication. The local demo uses an internal fallback
# only to sign non-sensitive demo session tokens. Never commit a real secret.
AUTH_SESSION_SECRET=

# External collaboration service. Leave empty until the verified URL is supplied.
NEXT_PUBLIC_SHELTER_MAP_URL=

# Verified organization details only. Empty values render as placeholders.
NEXT_PUBLIC_GJHRD_ADDRESS=
NEXT_PUBLIC_GJHRD_PHONE=
NEXT_PUBLIC_GJHRD_EMAIL=
NEXT_PUBLIC_CARRIER_ADDRESS=
NEXT_PUBLIC_CARRIER_PHONE=
NEXT_PUBLIC_CARRIER_EMAIL=
